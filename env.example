# 环境配置示例文件
# 复制此文件为 .env 并修改相应配置

# API配置
# 默认只监听回环地址。容器镜像里会显式覆盖成 0.0.0.0；在共享网络上跑本地开发时
# 不要改成 0.0.0.0，除非同时设置了 AIVIDEO_API_KEY——否则同网段任何人都能上传大
# 文件、发起 FFmpeg/ASR 任务并读取结果。
API_HOST=127.0.0.1
API_PORT=8000

# 保护接口所需的 API Key。留空表示不启用鉴权，仅适用于单机本地使用。
# API_KEY 一旦设置，除 / /health /info 外的接口都需要 X-API-Key 请求头。
# AIVIDEO_API_KEY=

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# 语音识别配置
# 中文转写的引导词，留空使用默认的"简体"（必须短，长提示会让分段变粗）
# ASR_INITIAL_PROMPT=
# 转录前的语言探测（约 0.15 秒），关掉则不会自动应用简体引导
ASR_LANGUAGE_DETECTION=true

# 字体配置
# 指定用于封面标题的中文字体文件；留空则自动探测系统字体
# AIVIDEO_CJK_FONT=

# 语义评分配置
# auto = 配置了 LLM 就用 LLM，否则用词典规则（默认）
# llm  = 强制用 LLM，provider 故障时直接报错而不是静默降级
# rules= 只用词典规则，不产生任何 LLM 调用
SEMANTIC_SCORING_MODE=auto
# 单次请求打分的候选片段数；片段多时会自动分批
SEMANTIC_SCORING_BATCH=20

# 后台任务配置
# thread = 本机线程池（默认，无需 Redis）；celery = 分发到 Celery worker
JOB_BACKEND=thread
# 任务记录数据库位置，默认在数据根目录下的 aivideo.db
# AIVIDEO_DB_PATH=

# 产物与任务保留策略（天；0 表示关闭该项清理）
OUTPUT_RETENTION_DAYS=7
UPLOAD_RETENTION_DAYS=30
JOB_RETENTION_DAYS=30
# 后台清理间隔（小时；0 表示不自动清理）
RETENTION_SWEEP_INTERVAL_HOURS=6

# 媒体并发配置
# 同时允许运行的 FFmpeg 进程数，默认取 CPU 核数的一半
# MAX_CONCURRENT_MEDIA_JOBS=
# 等待空闲槽位的超时秒数，超时会报错而不是无限排队
MEDIA_SLOT_TIMEOUT=1800

# 视频处理配置
VIDEO_FPS=30
VIDEO_CRF=23
AUDIO_BITRATE=128k
MIN_CLIP_DURATION=10
MAX_CLIP_DURATION=60

# AI服务配置 (如果使用)
# GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# 文件存储配置
UPLOAD_BUCKET=ai-video-uploads
UPLOAD_BASE_URL=http://localhost:9000

# MinIO配置
MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=

# Flower监控配置
FLOWER_PORT=5555
# FLOWER_BASIC_AUTH=

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# 开发模式
DEBUG=false
RELOAD=false

# 健康检查配置
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# 安全与上传限制
MAX_FILE_SIZE=524288000
MAX_IMAGE_FILE_SIZE=26214400
ALLOW_UNSAFE_LOCAL_PATHS=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# AIVIDEO_API_KEY=replace-with-a-strong-random-value
